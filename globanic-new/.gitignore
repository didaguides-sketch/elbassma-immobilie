# dependencies
/node_modules

# next.js build output
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# environment files — never commit real secrets.
# .env.example is a template with no real values and IS tracked.
.env
.env.*
!.env.example

# local file storage (STORAGE_PROVIDER=local, dev only — see README)
/.local-storage

# vercel
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor
.DS_Store
*.pem
