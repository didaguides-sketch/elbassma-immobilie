# Database (Postgres — Neon / Supabase / self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/globanic?schema=public"

# Auth.js
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# File Storage (Phase 5)
# ------------------------------------------------------------
# "local"  -> filesystem under LOCAL_STORAGE_DIR. Dev only — the app
#             refuses to start with STORAGE_PROVIDER=local when
#             NODE_ENV=production (see src/server/storage/index.ts).
# "s3"     -> any S3-compatible provider: AWS S3, Cloudflare R2,
#             Supabase Storage, MinIO. Requires the S3_* variables below.
STORAGE_PROVIDER="local"

# Used only when STORAGE_PROVIDER=local. Defaults to ./.local-storage
# (already gitignored) if unset.
LOCAL_STORAGE_DIR="./.local-storage"

# Required when STORAGE_PROVIDER=s3 -------------------------------------
# AWS S3:
#   S3_REGION=us-east-1
#   S3_BUCKET=globanic-prod
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   S3_ENDPOINT=                        # leave empty for AWS S3
#
# Cloudflare R2:
#   S3_REGION=auto
#   S3_BUCKET=globanic-prod
#   S3_ACCESS_KEY_ID=<R2 access key id>
#   S3_SECRET_ACCESS_KEY=<R2 secret access key>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# Supabase Storage (S3-compatible endpoint):
#   S3_REGION=<project-region, e.g. us-east-1>
#   S3_BUCKET=<storage bucket name>
#   S3_ACCESS_KEY_ID=<from Supabase Storage settings>
#   S3_SECRET_ACCESS_KEY=<from Supabase Storage settings>
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#
# S3_PUBLIC_BASE_URL is OPTIONAL: only set it if the bucket sits behind a
# public CDN and you want to skip per-request URL signing (e.g. for
# PUBLISHED resources only). Leave unset to always use signed URLs.
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Search (phase 11 — optional, defaults to Postgres FTS)
# SEARCH_PROVIDER="postgres"

# ------------------------------------------------------------
# Analytics (Phase 7)
# ------------------------------------------------------------
# Salts the download rate-limit IP hash. Falls back to a dev-only default
# if unset — set a real random value in production (e.g. openssl rand -hex 32).
IP_HASH_SALT=""

# ------------------------------------------------------------
# SEO (Phase 12)
# ------------------------------------------------------------
# Used for canonical URLs, Open Graph tags, and sitemap.xml entries.
# Falls back to http://localhost:3000 in dev if unset — set the real
# production domain (no trailing slash) before deploying.
NEXT_PUBLIC_SITE_URL="https://globanic.com"
